model Tournament {
  id                   String                  @id @default(cuid())
  name                 String                  @default("Tournoi communautaire")
  creatorId            String
  scope                TournamentScope
  city                 String?
  region               String?
  country              String?
  continent            String?
  type                 TournamentType          @default(ELIMINATION)
  isPaid               Boolean                 @default(false)
  entryFee             Decimal                 @default(0) @db.Decimal(12, 2)
  entryPoints          Int                     @default(0)
  totalPrizePool       Decimal                 @default(0) @db.Decimal(12, 2)
  maxPlayers           Int
  status               TournamentStatus        @default(DRAFT)
  createdAt            DateTime                @default(now())
  platformFee          Decimal                 @default(0) @db.Decimal(12, 2)
  // Nouveaux champs pour le moteur de tournois
  gameType             GameType                @default(CHECKERS)
  draughtsVariant      DraughtsVariant         @default(INTERNATIONAL)
  timeControlMinutes   Int?
  minElo               Int?
  maxElo               Int?
  minPoints            Int?
  maxPoints            Int?
  initialCapital       Int?                    // Capital initial par joueur (Survival Bank)
  minBet               Int?                    // Mise minimale par match
  maxBet               Int?                    // Mise maximale par match
  betMode              TournamentBetMode       @default(FIXED)
  survivalBankEnabled  Boolean                 @default(false)
  rebuyEnabled         Boolean                 @default(false)
  rebuyCost            Int?                    // Coût du rebuy en points
  maxMatchesPerPlayer  Int?                    // Nombre max de matchs par joueur
  startedAt            DateTime?
  finishedAt           DateTime?
  winnerId             String?
  configSnapshot       Json?                   // Configuration figée au démarrage
  creator              User                    @relation("TournamentCreator", fields: [creatorId], references: [id])
  invitations          TournamentInvitation[]
  bracketMatches       TournamentMatch[]
  participants         TournamentParticipant[]
  wallets              TournamentWallet[]
  walletTransactions   TournamentWalletTransaction[]
  tournamentBets       TournamentBet[]
  rounds               TournamentRound[]

  @@index([status, scope])
  @@index([creatorId])
  @@index([type])
  @@index([status, type])
}

model TournamentInvitation {
  id           String                     @id @default(cuid())
  tournamentId String
  userId       String
  status       TournamentInvitationStatus @default(PENDING)
  createdAt    DateTime                   @default(now())
  respondedAt  DateTime?
  tournament   Tournament                 @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
  @@index([userId, status])
}

model MockPayment {
  id          String             @id @default(cuid())
  userId      String
  purpose     MockPaymentPurpose
  amount      Decimal            @db.Decimal(12, 2)
  referenceId String             @unique
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model BalanceTransaction {
  id              String                 @id @default(cuid())
  userId          String
  balanceType     BalanceType
  transactionType BalanceTransactionType
  amount          Decimal                @db.Decimal(14, 2)
  referenceId     String
  description     String
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id])

  @@unique([userId, transactionType, referenceId])
  @@index([userId, createdAt])
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  seed         Int
  placement    Int?
  status       TournamentParticipantStatus @default(ACTIVE)
  joinedAt     DateTime   @default(now())
  eliminatedAt DateTime?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@unique([tournamentId, seed])
  @@index([tournamentId, placement])
  @@index([tournamentId, status])
}

model TournamentMatch {
  id            String                @id @default(cuid())
  tournamentId  String
  roundId       String?               // Référence vers TournamentRound pour les formats avec rondes
  stage         TournamentMatchStage  @default(MAIN)
  round         Int
  matchNumber   Int
  playerWhiteId String?
  playerBlackId String?
  winnerId      String?
  loserId       String?
  status        TournamentMatchStatus @default(WAITING)
  betAmount     Int?                  // Mise pour ce match (Survival Bank)
  betStatus     BetStatus?            // Statut de la mise
  betSettled    Boolean               @default(false)
  whiteRemainingPieces Int?
  blackRemainingPieces Int?
  createdAt     DateTime              @default(now())
  completedAt   DateTime?
  loser         User?                 @relation("TournamentMatchLoser", fields: [loserId], references: [id])
  playerBlack   User?                 @relation("TournamentMatchBlack", fields: [playerBlackId], references: [id])
  playerWhite   User?                 @relation("TournamentMatchWhite", fields: [playerWhiteId], references: [id])
  tournament    Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  winner        User?                 @relation("TournamentMatchWinner", fields: [winnerId], references: [id])
  roundRef      TournamentRound?      @relation("TournamentRoundMatches", fields: [roundId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, stage, round, matchNumber])
  @@index([tournamentId, stage, round, status])
  @@index([roundId])
}

model AiGameReward {
  id         String   @id @default(cuid())
  userId     String
  gameId     String
  gameType   GameType
  difficulty String
  points     Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([createdAt])
}

enum GameType {
  CHESS
  CHECKERS
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  ABANDONED
}

enum TournamentScope {
  NEIGHBORHOOD
  CITY
  REGION
  COUNTRY
  CONTINENT
  INTERNATIONAL
}

enum TournamentStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum BalanceType {
  FREE_POINTS
  REAL_WALLET
  BET_ESCROW
}

enum BalanceTransactionType {
  MOCK_PURCHASE
  TOURNAMENT_ENTRY
  TOURNAMENT_PRIZE
  TOURNAMENT_POINTS_ENTRY
  TOURNAMENT_POINTS_PRIZE
  BET_PLACED
  BET_WON
  BET_LOST
  BET_REFUNDED
  GAME_POINTS_WON
  GAME_POINTS_LOST
  ELO_CHANGE
}

enum GameResult {
  WIN
  LOSS
  DRAW
}

enum BetStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  SETTLED
  REFUNDED
}

enum RatingChangeReason {
  GAME_WIN
  GAME_LOSS
  GAME_DRAW
  RESET
  CORRECTION
}

enum TournamentMatchStage {
  MAIN
  THIRD_PLACE
}

enum TournamentMatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum TournamentInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MockPaymentPurpose {
  PREMIUM_MEMBERSHIP
}

enum DraughtsVariant {
  ENGLISH
  INTERNATIONAL
}

enum TournamentType {
  SURVIVAL_BANK
  ARENA
  SWISS
  ROUND_ROBIN
  ELIMINATION
  DOUBLE_ELIMINATION
  GROUPS_ELIMINATION
  LEAGUE
}

enum TournamentParticipantStatus {
  ACTIVE
  ELIMINATED
  WON
  WITHDRAWN
}

enum TournamentWalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PLACED
  BET_WON
  BET_LOST
  BET_REFUNDED
  PRIZE_AWARDED
  PENALTY
}

enum TournamentBetMode {
  FIXED
  VARIABLE
}

model TournamentConfig {
  id             String   @id @default(cuid())
  key            String   @unique
  value          Json
  description    String?
  isEditable     Boolean  @default(true)
  updatedById    String?
  updatedBy      User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt      DateTime @updatedAt

  @@index([key])
}

model TournamentWallet {
  id             String   @id @default(cuid())
  tournamentId   String
  userId         String
  capital        Int      @default(0)
  initialCapital Int      @default(0)
  status         TournamentParticipantStatus @default(ACTIVE)
  eliminatedAt   DateTime?
  eliminationRound Int?
  eliminationReason String?
  totalBets      Int      @default(0)
  totalWon       Int      @default(0)
  totalLost      Int      @default(0)
  matchesPlayed  Int      @default(0)
  matchesWon     Int      @default(0)
  matchesLost    Int      @default(0)
  matchesDrawn   Int      @default(0)
  winStreak      Int      @default(0)
  bestWinStreak  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TournamentWalletTransaction[]
  bets         TournamentBet[]

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  @@index([userId])
}

model TournamentWalletTransaction {
  id             String   @id @default(cuid())
  walletId       String
  tournamentId   String
  userId         String
  type           TournamentWalletTransactionType
  amount         Int
  balanceAfter   Int
  referenceId    String?
  description    String?
  createdAt      DateTime @default(now())

  wallet   TournamentWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([tournamentId, createdAt])
  @@index([userId, createdAt])
}

model TournamentBet {
  id            String   @id @default(cuid())
  tournamentId  String
  matchId       String
  walletId      String
  userId        String
  amount        Int
  status        BetStatus @default(PROPOSED)
  proposedAt    DateTime @default(now())
  acceptedAt    DateTime?
  settledAt     DateTime?
  counterAmount Int?
  counterBy     String?

  tournament Tournament     @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  wallet     TournamentWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([matchId])
  @@index([status])
}

model TournamentRound {
  id             String   @id @default(cuid())
  tournamentId   String
  roundNumber    Int
  stage          String
  status         String
  startedAt      DateTime?
  completedAt    DateTime?

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      TournamentMatch[] @relation("TournamentRoundMatches")

  @@unique([tournamentId, roundNumber])
  @@index([tournamentId, status])
}

