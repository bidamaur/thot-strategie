generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model User {
  id                        String                        @id @default(cuid())
  email                     String?                       @unique
  username                  String                        @unique
  isPremium                 Boolean                       @default(false)
  pointsFree                Float                         @default(0)
  walletReal                Decimal                       @default(0) @db.Decimal(12, 2)
  /// Points argent bloqués (mises en cours) — jamais dépensables directement.
  walletLocked              Decimal                       @default(0) @db.Decimal(12, 2)
  /// Autorisation explicite (vérification/KYC) pour les parties rémunérées.
  moneyVerified             Boolean                       @default(false)
  premiumExpiresAt          DateTime?
  bio                       String?                       @db.VarChar(280)
  elo                       Int                           @default(1200)
  createdAt                 DateTime                      @default(now())
  draughtsVariant           DraughtsVariant               @default(INTERNATIONAL)
  city                      String?                       @db.VarChar(80)
  country                   String?                       @db.VarChar(80)
  isAdmin                   Boolean                       @default(false)
  premiumLevel              Int                           @default(0)
  neighborhood              String?                       @db.VarChar(80)
  passwordHash              String?
  avatar                    String?
  aiGameRewards             AiGameReward[]
  walletTransactions        BalanceTransaction[]
  proposedBets              Match[]                       @relation("MatchBetProposer")
  proposedGameBets          GameBet[]                     @relation("GameBetProposer")
  opponentGameBets          GameBet[]                     @relation("GameBetOpponent")
  blackMatches              Match[]                       @relation("BlackPlayer")
  whiteMatches              Match[]                       @relation("WhitePlayer")
  wonMatches                Match[]                       @relation("MatchWinner")
  playerRatings             PlayerRating[]
  ratingHistory             RatingHistory[]
  gameBetTransactions       GameBetTransaction[]
  mockPayments              MockPayment[]
  tournaments               Tournament[]                  @relation("TournamentCreator")
  tournamentInvitations     TournamentInvitation[]
  tournamentMatchesLost     TournamentMatch[]             @relation("TournamentMatchLoser")
  tournamentMatchesAsBlack  TournamentMatch[]             @relation("TournamentMatchBlack")
  tournamentMatchesAsWhite  TournamentMatch[]             @relation("TournamentMatchWhite")
  tournamentMatchesWon      TournamentMatch[]             @relation("TournamentMatchWinner")
  tournamentParticipations  TournamentParticipant[]
  tournamentWallets         TournamentWallet[]
  tournamentWalletTxs       TournamentWalletTransaction[]
  tournamentBets            TournamentBet[]
  tournamentConfigs         TournamentConfig[]
  sessions                  UserSession[]
  auditLogs                 AuditLog[]
  clubsOwned                Club[]                        @relation("ClubOwner")
  clubMemberships           ClubMember[]
  tournamentStopVotes       TournamentStopVote[]
  /// Communauté : informations visibles publiquement (voir lib/community/privacy.ts).
  privacySettings           Json?
  /// Communauté : types de notifications désactivés par le joueur.
  notificationPrefs         Json?
  lastSeenAt                DateTime?
  tournamentInvitationsSent TournamentInvitation[]        @relation("TournamentInviter")
  friendshipsRequested      Friendship[]                  @relation("FriendshipRequester")
  friendshipsReceived       Friendship[]                  @relation("FriendshipAddressee")
  blocksMade                UserBlock[]                   @relation("UserBlocker")
  blocksReceived            UserBlock[]                   @relation("UserBlocked")
  communityRoomsOwned       CommunityRoom[]               @relation("CommunityRoomOwner")
  communityRoomMemberships  CommunityRoomMember[]
  communityPosts            CommunityPost[]
  communityComments         CommunityComment[]
  communityReactions        CommunityReaction[]
  challengesSent            FriendChallenge[]             @relation("ChallengeChallenger")
  challengesReceived        FriendChallenge[]             @relation("ChallengeChallenged")
  notifications             Notification[]                @relation("NotificationRecipient")
  notificationsSent         Notification[]                @relation("NotificationActor")
  reportsMade               CommunityReport[]             @relation("ReportReporter")
  reportsReceived           CommunityReport[]             @relation("ReportTargetUser")
  reportsResolved           CommunityReport[]             @relation("ReportResolver")
  sanctions                 CommunitySanction[]           @relation("SanctionUser")
  sanctionsIssued           CommunitySanction[]           @relation("SanctionIssuer")
  clubInvitations           ClubInvitation[]              @relation("ClubInvitee")
  clubInvitationsSent       ClubInvitation[]              @relation("ClubInviter")
  clubMatchesProposed       ClubMatch[]                   @relation("ClubMatchProposer")
  clubBoardsHome            ClubMatchBoard[]              @relation("ClubBoardHome")
  clubBoardsAway            ClubMatchBoard[]              @relation("ClubBoardAway")
}

model UserSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Match {
  id                   String           @id @default(cuid())
  playerWhiteId        String
  playerBlackId        String?
  gameType             GameType
  betEnabled           Boolean          @default(false)
  betAmount            Int              @default(0)
  status               MatchStatus      @default(WAITING)
  winnerId             String?
  movesHistory         Json             @default("[]")
  createdAt            DateTime         @default(now())
  blackRemainingPieces Int?
  scoreDelta           Int?
  whiteRemainingPieces Int?
  draughtsVariant      DraughtsVariant?
  disconnectedAt       DateTime?
  disconnectedPlayerId String?
  timeControlMinutes   Int?
  rated                Boolean          @default(false)
  betStatus            BetStatus?
  betProposedById      String?
  betAcceptedAt        DateTime?
  betSettledAt         DateTime?
  result               GameResult?
  eloDeltaWhite        Int?
  eloDeltaBlack        Int?
  updatedAt            DateTime         @default(now()) @updatedAt
  /// Mode de jeu : CASUAL (amical), RATED (classé ELO), MONEY (rémunéré).
  mode                 MatchMode        @default(CASUAL)
  /// Mise en points argent par joueur (mode MONEY uniquement).
  stakeAmount          Decimal?         @db.Decimal(12, 2)
  stakeCommission      Decimal?         @db.Decimal(12, 2)
  ratingPool           String?
  /// Match de tournoi joué par cette partie (résultat reporté par le serveur).
  tournamentMatchId    String?          @unique
  tournamentMatch      TournamentMatch? @relation(fields: [tournamentMatchId], references: [id], onDelete: SetNull)
  friendChallenge      FriendChallenge?
  clubMatchBoard       ClubMatchBoard?
  gameBet              GameBet?
  resultRecord         MatchResult?
  ratingHistory        RatingHistory[]
  betProposedBy        User?            @relation("MatchBetProposer", fields: [betProposedById], references: [id], onUpdate: NoAction)
  playerBlack          User?            @relation("BlackPlayer", fields: [playerBlackId], references: [id])
  playerWhite          User             @relation("WhitePlayer", fields: [playerWhiteId], references: [id])
  winner               User?            @relation("MatchWinner", fields: [winnerId], references: [id])

  @@index([status, createdAt])
  @@index([playerWhiteId])
  @@index([playerBlackId])
  @@index([rated])
  @@index([betStatus])
  @@index([mode, status])
}

model PlayerRating {
  id               String   @id @default(cuid())
  userId           String
  variant          String
  timeControl      String?
  eloRating        Int      @default(1200)
  gamesPlayed      Int      @default(0)
  wins             Int      @default(0)
  losses           Int      @default(0)
  draws            Int      @default(0)
  ratingDeviation  Float    @default(350)
  lastRatingUpdate DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, variant, timeControl])
  @@index([variant, eloRating])
  @@index([userId])
}

model RatingHistory {
  id                   String             @id @default(cuid())
  userId               String
  variant              String
  timeControl          String?
  oldRating            Int
  newRating            Int
  change               Int
  reason               RatingChangeReason
  matchId              String?
  opponentId           String?
  opponentRatingBefore Int?
  createdAt            DateTime           @default(now())
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  match                Match?             @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([matchId])
}

model GameBet {
  id                String               @id @default(cuid())
  matchId           String               @unique
  proposerId        String
  opponentId        String
  amount            Int
  status            BetStatus            @default(PROPOSED)
  proposedAt        DateTime             @default(now())
  acceptedAt        DateTime?
  settledAt         DateTime?
  counterProposal   Int?
  counterProposedBy String?
  match             Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  proposer          User                 @relation("GameBetProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  opponent          User                 @relation("GameBetOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  transactions      GameBetTransaction[]

  @@index([status])
}

model GameBetTransaction {
  id        String   @id @default(cuid())
  betId     String
  userId    String
  amount    Int
  type      String
  createdAt DateTime @default(now())
  bet       GameBet  @relation(fields: [betId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([betId])
  @@index([userId, createdAt])
}

model MatchResult {
  id                String     @id @default(cuid())
  matchId           String     @unique
  whiteResult       GameResult
  blackResult       GameResult
  whitePointsChange Int
  blackPointsChange Int
  whiteEloChange    Int
  blackEloChange    Int
  betSettled        Boolean    @default(false)
  settledAt         DateTime?
  createdAt         DateTime   @default(now())
  match             Match      @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model Tournament {
  id                  String                        @id @default(cuid())
  name                String                        @default("Tournoi communautaire")
  creatorId           String
  scope               TournamentScope
  city                String?
  region              String?
  country             String?
  continent           String?
  type                TournamentType                @default(ELIMINATION)
  isPaid              Boolean                       @default(false)
  entryFee            Decimal                       @default(0) @db.Decimal(12, 2)
  entryPoints         Int                           @default(0)
  totalPrizePool      Decimal                       @default(0) @db.Decimal(12, 2)
  maxPlayers          Int
  status              TournamentStatus              @default(DRAFT)
  createdAt           DateTime                      @default(now())
  platformFee         Decimal                       @default(0) @db.Decimal(12, 2)
  // Nouveaux champs pour le moteur de tournois
  gameType            GameType                      @default(CHECKERS)
  draughtsVariant     DraughtsVariant               @default(INTERNATIONAL)
  timeControlMinutes  Int?
  minElo              Int?
  maxElo              Int?
  minPoints           Int?
  maxPoints           Int?
  initialCapital      Int? // Capital initial par joueur (Survival Bank)
  minBet              Int? // Mise minimale par match
  maxBet              Int? // Mise maximale par match
  betMode             TournamentBetMode             @default(FIXED)
  survivalBankEnabled Boolean                       @default(false)
  rebuyEnabled        Boolean                       @default(false)
  rebuyCost           Int? // Coût du rebuy en points
  maxMatchesPerPlayer Int? // Nombre max de matchs par joueur
  startedAt           DateTime?
  finishedAt          DateTime?
  winnerId            String?
  configSnapshot      Json? // Configuration figée au démarrage
  visibility          TournamentVisibility          @default(PUBLIC)
  clubId              String?
  description         String?                       @db.VarChar(1000)
  /// Survival : durée en jours ; le tournoi s'arrête automatiquement à `endsAt`.
  durationDays        Int?
  /// Arena : durée en minutes.
  durationMinutes     Int?
  endsAt              DateTime?
  stopVotes           TournamentStopVote[]
  club                Club?                         @relation(fields: [clubId], references: [id], onDelete: SetNull)
  creator             User                          @relation("TournamentCreator", fields: [creatorId], references: [id])
  invitations         TournamentInvitation[]
  bracketMatches      TournamentMatch[]
  participants        TournamentParticipant[]
  wallets             TournamentWallet[]
  walletTransactions  TournamentWalletTransaction[]
  tournamentBets      TournamentBet[]
  rounds              TournamentRound[]

  @@index([status, scope])
  @@index([creatorId])
  @@index([type])
  @@index([status, type])
  @@index([clubId])
  @@index([status, endsAt])
}

model TournamentInvitation {
  id           String                     @id @default(cuid())
  tournamentId String
  userId       String
  status       TournamentInvitationStatus @default(PENDING)
  createdAt    DateTime                   @default(now())
  respondedAt  DateTime?
  /// Auteur de l'invitation (organisateur ou ami) — null pour les invitations historiques.
  invitedById  String?
  tournament   Tournament                 @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?                      @relation("TournamentInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([tournamentId, userId])
  @@index([userId, status])
}

model MockPayment {
  id          String             @id @default(cuid())
  userId      String
  purpose     MockPaymentPurpose
  amount      Decimal            @db.Decimal(12, 2)
  referenceId String             @unique
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model BalanceTransaction {
  id              String                 @id @default(cuid())
  userId          String
  balanceType     BalanceType
  transactionType BalanceTransactionType
  amount          Decimal                @db.Decimal(14, 2)
  referenceId     String
  description     String
  createdAt       DateTime               @default(now())
  user            User                   @relation(fields: [userId], references: [id])

  @@unique([userId, transactionType, referenceId])
  @@index([userId, createdAt])
  @@index([userId, balanceType, createdAt])
}

model TournamentParticipant {
  id                String                      @id @default(cuid())
  tournamentId      String
  userId            String
  seed              Int
  placement         Int?
  status            TournamentParticipantStatus @default(ACTIVE)
  joinedAt          DateTime                    @default(now())
  eliminatedAt      DateTime?
  /// Arena : en attente d'un adversaire depuis cette date.
  arenaWaitingSince DateTime?
  tournament        Tournament                  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user              User                        @relation(fields: [userId], references: [id])

  @@unique([tournamentId, userId])
  @@unique([tournamentId, seed])
  @@index([tournamentId, placement])
  @@index([tournamentId, status])
  @@index([tournamentId, arenaWaitingSince])
}

model TournamentMatch {
  id                   String                @id @default(cuid())
  tournamentId         String
  roundId              String? // Référence vers TournamentRound pour les formats avec rondes
  stage                TournamentMatchStage  @default(MAIN)
  round                Int
  matchNumber          Int
  playerWhiteId        String?
  playerBlackId        String?
  winnerId             String?
  loserId              String?
  status               TournamentMatchStatus @default(WAITING)
  betAmount            Int? // Mise pour ce match (Survival Bank)
  groupNumber          Int? // Phase de groupes : numéro du groupe (1, 2, …)
  betStatus            BetStatus? // Statut de la mise
  betSettled           Boolean               @default(false)
  whiteRemainingPieces Int?
  blackRemainingPieces Int?
  createdAt            DateTime              @default(now())
  completedAt          DateTime?
  loser                User?                 @relation("TournamentMatchLoser", fields: [loserId], references: [id])
  playerBlack          User?                 @relation("TournamentMatchBlack", fields: [playerBlackId], references: [id])
  playerWhite          User?                 @relation("TournamentMatchWhite", fields: [playerWhiteId], references: [id])
  tournament           Tournament            @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  winner               User?                 @relation("TournamentMatchWinner", fields: [winnerId], references: [id])
  roundRef             TournamentRound?      @relation("TournamentRoundMatches", fields: [roundId], references: [id], onDelete: SetNull)
  games                Match[]

  @@unique([tournamentId, stage, round, matchNumber])
  @@index([tournamentId, stage, round, status])
  @@index([roundId])
}

model AiGameReward {
  id         String   @id @default(cuid())
  userId     String
  gameId     String
  gameType   GameType
  difficulty String
  points     Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([createdAt])
}

enum GameType {
  CHESS
  CHECKERS
}

enum MatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  ABANDONED
  ABORTED
}

enum MatchMode {
  CASUAL
  RATED
  MONEY
}

enum TournamentVisibility {
  PUBLIC
  PRIVATE
  CLUB
}

enum ClubRole {
  OWNER
  ADMIN
  MEMBER
}

enum TournamentScope {
  NEIGHBORHOOD
  CITY
  REGION
  COUNTRY
  CONTINENT
  INTERNATIONAL
}

enum TournamentStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum BalanceType {
  FREE_POINTS
  REAL_WALLET
  BET_ESCROW
  MONEY_LOCKED
}

enum BalanceTransactionType {
  MOCK_PURCHASE
  TOURNAMENT_ENTRY
  TOURNAMENT_PRIZE
  TOURNAMENT_POINTS_ENTRY
  TOURNAMENT_POINTS_PRIZE
  TOURNAMENT_POINTS_REBUY
  BET_PLACED
  BET_WON
  BET_LOST
  BET_REFUNDED
  GAME_POINTS_WON
  GAME_POINTS_LOST
  ELO_CHANGE
  MONEY_STAKE_LOCKED
  MONEY_STAKE_WON
  MONEY_STAKE_LOST
  MONEY_STAKE_REFUNDED
  MONEY_COMMISSION
  ADMIN_ADJUSTMENT
}

enum GameResult {
  WIN
  LOSS
  DRAW
}

enum BetStatus {
  PROPOSED
  ACCEPTED
  REJECTED
  COUNTERED
  EXPIRED
  SETTLED
  REFUNDED
}

enum RatingChangeReason {
  GAME_WIN
  GAME_LOSS
  GAME_DRAW
  RESET
  CORRECTION
}

enum TournamentMatchStage {
  MAIN
  THIRD_PLACE
  GROUP
  KNOCKOUT
  WINNERS
  LOSERS
  GRAND_FINAL
}

enum TournamentMatchStatus {
  WAITING
  IN_PROGRESS
  FINISHED
}

enum TournamentInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum MockPaymentPurpose {
  PREMIUM_MEMBERSHIP
}

enum DraughtsVariant {
  ENGLISH
  INTERNATIONAL
}

enum TournamentType {
  SURVIVAL_BANK
  ARENA
  SWISS
  ROUND_ROBIN
  ELIMINATION
  DOUBLE_ELIMINATION
  GROUPS_ELIMINATION
  LEAGUE
}

enum TournamentParticipantStatus {
  ACTIVE
  ELIMINATED
  WON
  WITHDRAWN
}

enum TournamentWalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PLACED
  BET_WON
  BET_LOST
  BET_REFUNDED
  PRIZE_AWARDED
  PENALTY
}

enum TournamentBetMode {
  FIXED
  VARIABLE
}

model TournamentConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       Json
  description String?
  isEditable  Boolean  @default(true)
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt

  @@index([key])
}

model TournamentWallet {
  id                String                      @id @default(cuid())
  tournamentId      String
  userId            String
  capital           Int                         @default(0)
  initialCapital    Int                         @default(0)
  status            TournamentParticipantStatus @default(ACTIVE)
  eliminatedAt      DateTime?
  eliminationRound  Int?
  eliminationReason String?
  totalBets         Int                         @default(0)
  totalWon          Int                         @default(0)
  totalLost         Int                         @default(0)
  matchesPlayed     Int                         @default(0)
  matchesWon        Int                         @default(0)
  matchesLost       Int                         @default(0)
  matchesDrawn      Int                         @default(0)
  winStreak         Int                         @default(0)
  bestWinStreak     Int                         @default(0)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  tournament   Tournament                    @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TournamentWalletTransaction[]
  bets         TournamentBet[]

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
  @@index([userId])
}

model TournamentWalletTransaction {
  id           String                          @id @default(cuid())
  walletId     String
  tournamentId String
  userId       String
  type         TournamentWalletTransactionType
  amount       Int
  balanceAfter Int
  referenceId  String?
  description  String?
  createdAt    DateTime                        @default(now())

  wallet     TournamentWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@index([tournamentId, createdAt])
  @@index([userId, createdAt])
}

model TournamentBet {
  id            String    @id @default(cuid())
  tournamentId  String
  matchId       String
  walletId      String
  userId        String
  amount        Int
  status        BetStatus @default(PROPOSED)
  proposedAt    DateTime  @default(now())
  acceptedAt    DateTime?
  settledAt     DateTime?
  counterAmount Int?
  counterBy     String?

  tournament Tournament       @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  wallet     TournamentWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tournamentId])
  @@index([matchId])
  @@index([status])
}

model TournamentRound {
  id           String    @id @default(cuid())
  tournamentId String
  roundNumber  Int
  stage        String
  status       String
  startedAt    DateTime?
  completedAt  DateTime?

  tournament Tournament        @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches    TournamentMatch[] @relation("TournamentRoundMatches")

  @@unique([tournamentId, roundNumber])
  @@index([tournamentId, status])
}

/// Journal d'audit des opérations sensibles (paramètres, soldes, rôles).
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String   @db.VarChar(80)
  entity    String   @db.VarChar(80)
  entityId  String?  @db.VarChar(120)
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId, createdAt])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model Club {
  id              String           @id @default(cuid())
  name            String           @unique @db.VarChar(60)
  slug            String           @unique @db.VarChar(70)
  description     String?          @db.VarChar(1000)
  ownerId         String
  country         String?          @db.VarChar(80)
  city            String?          @db.VarChar(80)
  accentColor     String?          @db.VarChar(9)
  isPrivate       Boolean          @default(false)
  maxMembers      Int              @default(50)
  createdAt       DateTime         @default(now())
  /// Logo du club (fichier image servi depuis /uploads).
  logo            String?          @db.VarChar(300)
  owner           User             @relation("ClubOwner", fields: [ownerId], references: [id])
  members         ClubMember[]
  tournaments     Tournament[]
  posts           CommunityPost[]
  invitations     ClubInvitation[]
  clubMatchesHome ClubMatch[]      @relation("ClubMatchHome")
  clubMatchesAway ClubMatch[]      @relation("ClubMatchAway")

  @@index([ownerId])
  @@index([country, city])
}

/// Survival : vote d'arrêt anticipé (le tournoi s'arrête si tous les joueurs actifs sont d'accord).
model TournamentStopVote {
  id           String     @id @default(cuid())
  tournamentId String
  userId       String
  createdAt    DateTime   @default(now())
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model ClubMember {
  id       String   @id @default(cuid())
  clubId   String
  userId   String
  role     ClubRole @default(MEMBER)
  joinedAt DateTime @default(now())
  club     Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId])
}

// ══════════════════════════════════════════════════════════════════════
// Communauté : amitiés, fil, salons, défis, notifications, modération
// ══════════════════════════════════════════════════════════════════════

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// Une seule relation par paire de joueurs (pairKey = "idMin:idMax").
model Friendship {
  id                String           @id @default(cuid())
  requesterId       String
  addresseeId       String
  pairKey           String           @unique @db.VarChar(80)
  status            FriendshipStatus @default(PENDING)
  requesterFavorite Boolean          @default(false)
  addresseeFavorite Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  respondedAt       DateTime?
  requester         User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee         User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

enum CommunityRoomVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityPostPermission {
  EVERYONE
  MEMBERS
  MODERATORS
}

enum CommunityRoomRole {
  OWNER
  MODERATOR
  MEMBER
}

/// Salon thématique — sert aussi de catégorie de publication (Général, Échecs, Dames…).
model CommunityRoom {
  id              String                  @id @default(cuid())
  slug            String                  @unique @db.VarChar(60)
  name            String                  @db.VarChar(60)
  description     String?                 @db.VarChar(300)
  icon            String?                 @db.VarChar(20)
  isActive        Boolean                 @default(true)
  visibility      CommunityRoomVisibility @default(PUBLIC)
  postPermission  CommunityPostPermission @default(EVERYONE)
  commentsEnabled Boolean                 @default(true)
  sortOrder       Int                     @default(0)
  ownerId         String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  owner           User?                   @relation("CommunityRoomOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  members         CommunityRoomMember[]
  posts           CommunityPost[]

  @@index([isActive, sortOrder])
  @@index([ownerId])
}

model CommunityRoomMember {
  id       String            @id @default(cuid())
  roomId   String
  userId   String
  role     CommunityRoomRole @default(MEMBER)
  /// Suivre le salon : notification pour les publications importantes (épinglées).
  follow   Boolean           @default(true)
  joinedAt DateTime          @default(now())
  room     CommunityRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

enum CommunityLinkType {
  TOURNAMENT
  CLUB
}

model CommunityPost {
  id            String              @id @default(cuid())
  authorId      String
  roomId        String?
  clubId        String?
  title         String?             @db.VarChar(140)
  body          String              @db.Text
  imageUrl      String?             @db.VarChar(300)
  linkType      CommunityLinkType?
  linkId        String?             @db.VarChar(40)
  isPinned      Boolean             @default(false)
  isHidden      Boolean             @default(false)
  commentCount  Int                 @default(0)
  reactionCount Int                 @default(0)
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  author        User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  room          CommunityRoom?      @relation(fields: [roomId], references: [id], onDelete: SetNull)
  club          Club?               @relation(fields: [clubId], references: [id], onDelete: Cascade)
  comments      CommunityComment[]
  reactions     CommunityReaction[]
  reports       CommunityReport[]

  @@index([createdAt])
  @@index([roomId, createdAt])
  @@index([clubId, createdAt])
  @@index([authorId, createdAt])
}

model CommunityComment {
  id            String              @id @default(cuid())
  postId        String
  authorId      String
  parentId      String?
  body          String              @db.VarChar(2000)
  isHidden      Boolean             @default(false)
  reactionCount Int                 @default(0)
  replyCount    Int                 @default(0)
  editedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  post          CommunityPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  author        User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent        CommunityComment?   @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       CommunityComment[]  @relation("CommentReplies")
  reactions     CommunityReaction[]
  reports       CommunityReport[]

  @@index([postId, parentId, createdAt])
  @@index([authorId, createdAt])
}

enum CommunityReactionType {
  LIKE
  BRAVO
  INTERESTING
  CONGRATS
}

/// Une réaction par joueur et par contenu (changer de réaction remplace la précédente).
model CommunityReaction {
  id        String                @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  type      CommunityReactionType
  createdAt DateTime              @default(now())
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment   CommunityComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
}

enum FriendChallengeStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
  COMPLETED
}

/// Défi direct entre amis : à l'acceptation, une partie classique est créée (même moteur que le reste).
model FriendChallenge {
  id                 String                @id @default(cuid())
  challengerId       String
  challengedId       String
  gameType           GameType
  draughtsVariant    DraughtsVariant?
  timeControlMinutes Int?
  mode               MatchMode             @default(CASUAL)
  /// Mise en points argent par joueur (mode MONEY uniquement, bloquée seulement à l'acceptation).
  stakeAmount        Int?
  /// "random", "white" ou "black" (couleur du lanceur du défi).
  challengerColor    String                @default("random") @db.VarChar(6)
  message            String?               @db.VarChar(200)
  status             FriendChallengeStatus @default(PENDING)
  matchId            String?               @unique
  expiresAt          DateTime
  respondedAt        DateTime?
  createdAt          DateTime              @default(now())
  challenger         User                  @relation("ChallengeChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  challenged         User                  @relation("ChallengeChallenged", fields: [challengedId], references: [id], onDelete: Cascade)
  match              Match?                @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([challengedId, status])
  @@index([challengerId, status])
  @@index([status, expiresAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String    @db.VarChar(40)
  actorId   String?
  title     String    @db.VarChar(160)
  body      String?   @db.VarChar(300)
  link      String?   @db.VarChar(300)
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

enum CommunityReportTarget {
  POST
  COMMENT
  USER
}

enum CommunityReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model CommunityReport {
  id           String                @id @default(cuid())
  reporterId   String
  targetType   CommunityReportTarget
  postId       String?
  commentId    String?
  targetUserId String?
  reason       String                @db.VarChar(40)
  details      String?               @db.VarChar(500)
  status       CommunityReportStatus @default(OPEN)
  resolvedById String?
  resolution   String?               @db.VarChar(300)
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())
  reporter     User                  @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User?                 @relation("ReportTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  resolvedBy   User?                 @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  post         CommunityPost?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment      CommunityComment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([reporterId, postId])
  @@unique([reporterId, commentId])
  @@index([status, createdAt])
  @@index([targetUserId])
}

enum CommunitySanctionType {
  WARNING
  MUTE
  SUSPENSION
}

/// Sanctions communautaires (historique conservé ; levée = revokedAt).
model CommunitySanction {
  id         String                @id @default(cuid())
  userId     String
  type       CommunitySanctionType
  reason     String                @db.VarChar(300)
  issuedById String?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime              @default(now())
  user       User                  @relation("SanctionUser", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy   User?                 @relation("SanctionIssuer", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId, type])
}

model ClubInvitation {
  id          String                     @id @default(cuid())
  clubId      String
  userId      String
  invitedById String
  status      TournamentInvitationStatus @default(PENDING)
  createdAt   DateTime                   @default(now())
  respondedAt DateTime?
  club        Club                       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  user        User                       @relation("ClubInvitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy   User                       @relation("ClubInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([clubId, userId])
  @@index([userId, status])
}

// ── Rencontres interclubs ─────────────────────────────────────────────

enum ClubMatchStatus {
  PROPOSED
  LINEUP
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
  EXPIRED
}

/// Rencontre club contre club sur N échiquiers (chaque échiquier = une partie classique).
model ClubMatch {
  id                 String           @id @default(cuid())
  homeClubId         String
  awayClubId         String
  proposedById       String
  boards             Int
  gameType           GameType
  draughtsVariant    DraughtsVariant?
  timeControlMinutes Int?
  /// CASUAL ou RATED (jamais de points argent en interclubs).
  mode               MatchMode        @default(CASUAL)
  message            String?          @db.VarChar(300)
  status             ClubMatchStatus  @default(PROPOSED)
  homeScore          Float            @default(0)
  awayScore          Float            @default(0)
  winnerClubId       String?
  expiresAt          DateTime
  respondedAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  homeClub           Club             @relation("ClubMatchHome", fields: [homeClubId], references: [id], onDelete: Cascade)
  awayClub           Club             @relation("ClubMatchAway", fields: [awayClubId], references: [id], onDelete: Cascade)
  proposedBy         User             @relation("ClubMatchProposer", fields: [proposedById], references: [id], onDelete: Cascade)
  boardList          ClubMatchBoard[]

  @@index([homeClubId, status])
  @@index([awayClubId, status])
  @@index([status, expiresAt])
}

model ClubMatchBoard {
  id           String    @id @default(cuid())
  clubMatchId  String
  board        Int
  homePlayerId String?
  awayPlayerId String?
  /// Le club recevant a les blancs aux échiquiers impairs.
  homeIsWhite  Boolean
  matchId      String?   @unique
  /// HOME, AWAY ou DRAW une fois la partie terminée.
  result       String?   @db.VarChar(5)
  clubMatch    ClubMatch @relation(fields: [clubMatchId], references: [id], onDelete: Cascade)
  homePlayer   User?     @relation("ClubBoardHome", fields: [homePlayerId], references: [id], onDelete: SetNull)
  awayPlayer   User?     @relation("ClubBoardAway", fields: [awayPlayerId], references: [id], onDelete: SetNull)
  match        Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([clubMatchId, board])
  @@index([homePlayerId])
  @@index([awayPlayerId])
}
